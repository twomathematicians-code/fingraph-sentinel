# FinGraph Sentinel — Environment Configuration
# Copy to .env and adjust for your deployment.

# LLM (optional — leave empty for deterministic rule-based mode)
FS_LLM_PROVIDER=ollama
FS_LLM_MODEL=llama3.2
FS_LLM_API_BASE=http://localhost:11434
FS_LLM_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fingraph-demo

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=INFO
